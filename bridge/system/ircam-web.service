[Unit]
Description=Wireless P2 Pro bridge: browser viewer (optional, port 8080)
After=ircam-bridge.service
Wants=ircam-bridge.service

[Service]
User=ircam
Group=ircam
ExecStart=/usr/bin/python3 /opt/ircam-bridge/ircam_web.py --tap /run/ircam-bridge/tap.sock --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
